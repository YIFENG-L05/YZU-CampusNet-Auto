<?xml version="1.0" encoding="utf-8"?>
<!--
  首次启动说明（**只在第一次打开应用时**显示，读完才能继续）。

  设计要点：
    · 正文在一个**有高度上限的滚动区**里，底部按钮固定 → 任何屏幕尺寸下按钮都不会被正文挤走
    · 用户**滚到底**之后按钮才从「请阅读完整内容」变成可点的「我已阅读并继续」
    · 点空白、返回键、延时都不能完成引导（返回键只是把应用退到后台，引导状态保持未完成）
    · 这里**只讲"什么时候会自动连接 / 不会连接 / 怎么用"**；
      隐私声明、许可、第三方组件等都在「设置」里，不在这里重复
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/firstLaunchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_scrim"
    android:paddingHorizontal="16dp"
    android:paddingVertical="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/firstLaunchTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_first_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.campusnet.auto.ui.views.MaxHeightScrollView
            android:id="@+id/firstLaunchScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.RowSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_first_intro" />

                <TextView
                    style="@style/Text.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/ui_first_when_yes_title" />

                <TextView
                    android:id="@+id/firstLaunchBodyYes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    style="@style/Text.RowSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/ui_first_how_connect" />

                <TextView
                    style="@style/Text.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/ui_first_when_no_title" />

                <TextView
                    android:id="@+id/firstLaunchBodyNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/firstLaunchNever"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/ui_first_never"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    style="@style/Text.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/ui_first_steps_title" />

                <TextView
                    android:id="@+id/firstLaunchBodySteps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    style="@style/Text.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/ui_first_states_title" />

                <TextView
                    android:id="@+id/firstLaunchBodyStates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    style="@style/Text.RowSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/ui_first_footer_hint" />
            </LinearLayout>
        </com.campusnet.auto.ui.views.MaxHeightScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/divider" />

        <Button
            android:id="@+id/firstLaunchContinue"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_btn_primary"
            android:enabled="false"
            android:text="@string/ui_first_read_required"
            android:textAllCaps="false"
            android:textColor="@color/text_disabled"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
