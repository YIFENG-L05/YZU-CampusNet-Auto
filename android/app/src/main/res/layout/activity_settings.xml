<?xml version="1.0" encoding="utf-8"?>
<!--
  设置页（第五阶段）：校园 Wi-Fi 规则 + 账号 + 密码 + 自动认证开关 + 手动操作。

  ⚠ 密码框是 textPassword；**保存后立刻清空**，界面上永远不回显密码。
  ⚠ 不硬编码任何学校名：那里只是输入框，用户填自己学校的 SSID。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_rule_title"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/ruleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/ruleExact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_rule_exact" />

            <RadioButton
                android:id="@+id/rulePrefix"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_rule_prefix" />

            <RadioButton
                android:id="@+id/ruleRegex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_rule_regex" />
        </RadioGroup>

        <EditText
            android:id="@+id/ruleValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_rule_value_hint"
            android:inputType="text"
            android:maxLines="1" />

        <TextView
            android:id="@+id/ruleHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/currentSsidLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textIsSelectable="true"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnUseCurrentSsid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_use_current_ssid" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_account_title"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/accountInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_account_hint"
            android:inputType="text"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_password_title"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_password_hint"
            android:inputType="textPassword"
            android:maxLines="1" />

        <!-- 密码默认隐藏；点这里切换显示（用户要求 §19） -->
        <LinearLayout
            android:id="@+id/passwordToggleRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <TextView
                android:id="@+id/passwordToggleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="显示密码"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/passwordToggleState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已隐藏"
                android:textColor="@color/text_tertiary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/credentialState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp" />

        <Switch
            android:id="@+id/switchAutoAuth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/home_switch_auto_auth" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_service_title"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_service_note"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/serviceInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_service_hint"
            android:inputType="text"
            android:maxLines="1" />

        <Button
            android:id="@+id/btnFetchServices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_fetch_services" />

        <TextView
            android:id="@+id/serviceListLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_btn_save" />

        <Button
            android:id="@+id/btnCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_btn_check" />

        <Button
            android:id="@+id/btnAuth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_btn_auth" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_btn_stop" />

        <TextView
            android:id="@+id/saveResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textIsSelectable="true"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_security_note"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>
