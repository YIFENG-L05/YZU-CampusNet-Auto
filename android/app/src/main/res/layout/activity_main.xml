<?xml version="1.0" encoding="utf-8"?>
<!--
  应用外壳（Light UI）。

  结构：
    · 主体：页面容器（首页 / 设置，以及二级页面）
    · 底部：**两段式 Dock**（首页 | 设置），固定在底部
    · 最上层：覆盖层（开启确认流程 / 文档 / 诊断结果）

  ⚠ 系统栏适配（用户要求 §2.2）：
     targetSdk 35+ 强制 edge-to-edge，所以这里**不写死任何 margin**，
     由 MainActivity 用 WindowInsets 给 pageContainer 加 top、给 bottomNav 加 bottom。
     换机型/横竖屏/手势导航都不会错位。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/pageContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:id="@+id/navDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- 底部 Dock：只有两项（首页 / 设置）。日志已收口进设置。
             ⚠ 高度：这里是**基准高度**，运行时 MainActivity 会再**加上系统导航栏 inset**
               （固定高度 + 大 inset 会把图标和文字挤掉 —— 用户报的"字符展示不全"）。
               两个值必须与 MainActivity 的 DOCK_BASE_DP 保持一致。 -->
        <LinearLayout
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="@color/nav_bar"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp">

            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/navHomeIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/ui_nav_home"
                    android:src="@drawable/ic_nav_home" />

                <TextView
                    android:id="@+id/navHomeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:text="@string/ui_nav_home"
                    android:textColor="@color/nav_selected"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/navSettingsIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/ui_nav_settings"
                    android:src="@drawable/ic_nav_settings" />

                <TextView
                    android:id="@+id/navSettingsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:text="@string/ui_nav_settings"
                    android:textColor="@color/nav_unselected"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/overlayContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
