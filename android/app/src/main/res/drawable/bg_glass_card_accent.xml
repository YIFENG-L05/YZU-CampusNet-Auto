<?xml version="1.0" encoding="utf-8"?>
<!-- 强调信息的玻璃卡（用于"需要你处理"这类状态）：底纹带一点主色，仍然低饱和 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="18dp" />
    <gradient
        android:angle="270"
        android:startColor="@color/glass_fill"
        android:centerColor="@color/glass_fill_soft"
        android:endColor="@color/accent_dim" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_stroke" />
</shape>
