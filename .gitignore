# ── 依赖 ──
node_modules/

# ── 构建产物 ──
dist/
release/
out/

# ── 本地缓存 ──
# .npm-cache / .cache 刻意放在项目内（理由见 .npmrc 顶部注释），好处是"删项目目录 = 彻底清理"。
# 其中 .cache/userdata 是开发期的数据目录：配置、凭据、日志、截图都在里面，绝不能提交。
.npm-cache/
.cache/

# ── 探针产物 ──
# 记录着本校门户的真实结构与设备标识，属于本地资料。
tools/out/

# ── 回退备份 ──
# 开发版数据目录的关键文件备份（含加密凭据与 safeStorage 密钥），
# 用于从正式版回退时恢复配置。绝对不进版本库。
backup/

# ── 敏感文件兜底 ──
# 正式版凭据走 Windows DPAPI，存在 %APPDATA%\CampusNetAuto（仓库之外）。
# 这一节是防止明文凭证被误放进项目后又被提交。
credential.bin
config.json
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# ── 日志与临时文件 ──
*.log
*.log.*
*.tmp
*.bak
*.orig
*.rej
Thumbs.db
.DS_Store

# ── Android / Gradle ──
# android/ 是独立的 Gradle 工程（边界见 android/BOUNDARY.md）。
# 它不会进 Windows 安装包：package.json 的 build.files 只收 src/** 与 package.json。
android/.gradle/
android/.kotlin/
android/.cxx/
android/build/
android/app/build/
android/local.properties
# 构建期从仓库 src/ 同步过来的 JS 副本（源只有一份，在 src/ 里）
android/app/src/main/assets/core/
# Gradle wrapper **必须提交**（别人要靠它构建），所以这里不忽略 gradle/wrapper/
*.apk
*.aab
captures/
logs/

# ── Gradle / JVM（根目录兜底）──
.gradle/
build/tmp/
local.properties
*.hprof

# ── 编辑器 ──
.vscode/
.idea/
*.iml
*.swp
*~

# ── 内部过程笔记（只在本地，不进公开仓库）──
# 这两份是发布/交接过程中的工作稿（逐条过程流水与内部交接说明），
# 不属于对外文档；面向用户与开发者的说明在 README.md / docs/ / android/*.md 里。
RELEASE_CHECKPOINT.md
android/UI_HANDOFF.md

