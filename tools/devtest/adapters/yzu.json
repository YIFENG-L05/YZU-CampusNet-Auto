{
  "id": "mock-yzu",
  "name": "模拟门户 · 扬州大学真实链路（ePortal 多跳 -> 跨域 SSO，JS 延迟渲染表单）",
  "_devOnly": true,
  "urlPatterns": ["/sso/login", "sso\\.yzu", "eportal/index\\.jsp"],
  "readySelector": "input[name=\"username\"]",
  "readyTimeoutMs": 15000,
  "username": "input[name=\"username\"]:not([type=hidden])",
  "password": "input[type=\"password\"]",
  "operator": {
    "kind": "none",
    "selector": null,
    "values": {}
  },
  "loginButton": "button.login-button[type=\"submit\"]",
  "submitForm": null,
  "successTexts": ["认证成功"],
  "errorTexts": ["用户名或密码错误", "密码错误", "账号或密码错误", "验证码"],
  "waitAfterSubmitMs": 10000
}
