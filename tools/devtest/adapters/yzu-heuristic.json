{
  "id": "mock-yzu-heuristic",
  "name": "模拟门户 · 用启发式识别服务选择页（不写死选择器）",
  "_devOnly": true,
  "_why": "真实的服务选择页只在认证成功后才出现，登录前抓不到它的 HTML，选择器无法事先获得。所以这里不写选择器，改成按运营商文字（中国移动/中国联通/中国电信/校园网内网）识别控件并确认。同一个适配器要能同时应付 select 形态和 radio 形态。",
  "urlPatterns": ["/sso/login", "eportal/index\\.jsp"],
  "readySelector": "input[name=\"username\"]:not([type=hidden])",
  "readyTimeoutMs": 15000,
  "username": "input[name=\"username\"]:not([type=hidden])",
  "password": "input[type=\"password\"]",
  "operator": {
    "kind": "heuristic",
    "selector": null,
    "values": {}
  },
  "successTexts": ["认证成功"],
  "errorTexts": ["用户名或密码错误", "密码错误", "请选择正确的网络服务"],
  "waitAfterSubmitMs": 12000,
  "steps": [
    { "action": "waitFor", "selector": "input[name=\"username\"]:not([type=hidden])", "timeoutMs": 15000 },
    { "action": "fill" },
    { "action": "sleep", "ms": 200 },
    { "action": "submit", "selector": "button.login-button[type=\"submit\"]" },
    {
      "action": "selectService",
      "labels": ["中国移动", "中国联通", "中国电信", "校园网内网"],
      "confirmTexts": ["确认", "确定", "连接", "下一步", "提交"],
      "timeoutMs": 10000,
      "optional": true,
      "group": "service"
    },
    { "action": "sleep", "ms": 800 }
  ]
}
